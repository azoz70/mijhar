[7.683243, "o", "\u001b[1;38;2;127;215;232m\u256d\u2500\u001b[0m\u001b[1;38;2;127;215;232m MIJHAR SECURITY ASSESSMENT \u001b[0m\u001b[1;38;2;127;215;232m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m\u001b[1;38;2;127;215;232m\u2500\u256e\u001b[0m\n\u001b[1;38;2;127;215;232m\u2502\u001b[0m \u001b[1mSYSTEM\u001b[0m        : MACOS                                                                                                \u001b[1;38;2;127;215;232m\u2502\u001b[0m\n\u001b[1;38;2;127;215;232m\u2502\u001b[0m \u001b[1mSCAN ID\u001b[0m       : S-1620855197                                                                                         \u001b[1;38;2;127;215;232m\u2502\u001b[0m\n\u001b[1;38;2;127;215;232m\u2502\u001b[0m \u001b[1mSCAN STATUS\u001b[0m   : \u001b[1;38;2;159;214;163mCOMPLETED\u001b[0m                                                                                            \u001b[1;38;2;127;215;232m\u2502\u001b[0m\n\u001b[1;38;2;127;215;232m\u2502\u001b[0m \u001b[1mCHECKS RUN\u001b[0m    : 6                                                                                                    \u001b[1;38;2;127;215;232m\u2502\u001b[0m\n\u001b[1;38;2;127;215;232m\u2502\u001b[0m \u001b[1mPASSED\u001b[0m        : \u001b[1;38;2;159;214;163m3\u001b[0m                                                                                                    \u001b[1;38;2;127;215;232m\u2502\u001b[0m\n\u001b[1;38;2;127;215;232m\u2502\u001b[0m \u001b[1mFAILED\u001b[0m        : \u001b[1;38;2;232;164;164m1\u001b[0m                                                                                                    \u001b[1;38;2;127;215;232m\u2502\u001b[0m\n\u001b[1;38;2;127;215;232m\u2502\u001b[0m \u001b[1mWARNINGS\u001b[0m      : \u001b[1;38;2;232;209;160m0\u001b[0m                                                                                                    \u001b[1;38;2;127;215;232m\u2502\u001b[0m\n\u001b[1;38;2;127;215;232m\u2502\u001b[0m \u001b[1mNOT SUPPORTED\u001b[0m : \u001b[38;2;159;176;192m0\u001b[0m                                                                                                    \u001b[1;38;2;127;215;232m\u2502\u001b[0m\n\u001b[1;38;2;127;215;232m\u2502\u001b[0m \u001b[1mERRORS\u001b[0m        : \u001b[1;38;2;201;174;232m2\u001b[0m                                                                                                    \u001b[1;38;2;127;215;232m\u2502\u001b[0m\n\u001b[1;38;2;127;215;232m\u2502\u001b[0m \u001b[1mEXCLUDED\u001b[0m      : \u001b[2;38;2;122;139;153m8\u001b[0m                                                                                                    \u001b[1;38;2;127;215;232m\u2502\u001b[0m\n\u001b[1;38;2;127;215;232m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256f\u001b[0m\n"]
