\u001b[38;2;122;139;153m\u2502\u001b[0m\u001b[38;2;234;244;248m \u001b[0m\u001b[38;2;234;244;248mFramework Coverage              \u001b[0m\u001b[38;2;234;244;248m \u001b[0m\u001b[38;2;122;139;153m\u2502\u001b[0m\u001b[38;2;122;139;153m \u001b[0m\u001b[38;2;122;139;153mExplore supported frameworks, controls, and mappings.                        \u001b[0m\u001b[38;2;122;139;153m \u001b[0m\u001b[38;2;122;139;153m\u2502\u001b[0m\n\u001b[38;2;122;139;153m\u2502\u001b[0m\u001b[38;2;122;139;153m \u001b[0m\u001b[38;2;122;139;153m4\u001b[0m\u001b[38;2;122;139;153m \u001b[0m\u001b[38;2;122;139;153m\u2502\u001b[0m\u001b[38;2;234;244;248m \u001b[0m\u001b[38;2;234;244;248mView Previous Assessments       \u001b[0m\u001b[38;2;234;244;248m \u001b[0m\u001b[38;2;122;139;153m\u2502\u001b[0m\u001b[38;2;122;139;153m \u001b[0m\u001b[38;2;122;139;153mReview past scans, findings, evidence, and summaries.                        \u001b[0m\u001b[38;2;122;139;153m \u001b[0m\u001b[38;2;122;139;153m\u2502\u001b[0m\n\u001b[38;2;122;139;153m\u2502\u001b[0m\u001b[38;2;122;139;153m \u001b[0m\u001b[38;2;122;139;153m5\u001b[0m\u001b[38;2;122;139;153m \u001b[0m\u001b[38;2;122;139;153m\u2502\u001b[0m\u001b[38;2;234;244;248m \u001b[0m\u001b[38;2;234;244;248mRemediation & Findings          \u001b[0m\u001b[38;2;234;244;248m \u001b[0m\u001b[38;2;122;139;153m\u2502\u001b[0m\u001b[38;2;122;139;153m \u001b[0m\u001b[38;2;122;139;153mReview findings, severity, fixes, and remediation progress.                  \u001b[0m\u001b[38;2;122;139;153m \u001b[0m\u001b[38;2;122;139;153m\u2502\u001b[0m\n\u001b[38;2;122;139;153m\u2502\u001b[0m\u001b[38;2;122;139;153m \u001b[0m\u001b[38;2;122;139;153m6\u001b[0m\u001b[38;2;122;139;153m \u001b[0m\u001b[38;2;122;139;153m\u2502\u001b[0m\u001b[38;2;234;244;248m \u001b[0m\u001b[38;2;234;244;248mHelp & Usage Guide              \u001b[0m\u001b[38;2;234;244;248m \u001b[0m\u001b[38;2;122;139;153m\u2502\u001b[0m\u001b[38;2;122;139;153m \u001b[0m\u001b[38;2;122;139;153mExplain what MIJHAR does and how to use it.                                  \u001b[0m\u001b[38;2;122;139;153m \u001b[0m\u001b[38;2;122;139;153m\u2502\u001b[0m\n\u001b[38;2;122;139;153m\u2502\u001b[0m\u001b[38;2;122;139;153m \u001b[0m\u001b[38;2;122;139;153m7\u001b[0m\u001b[38;2;122;139;153m \u001b[0m\u001b[38;2;122;139;153m\u2502\u001b[0m\u001b[38;2;234;244;248m \u001b[0m\u001b[38;2;234;244;248mAbout MIJHAR                    \u001b[0m\u001b[38;2;234;244;248m \u001b[0m\u001b[38;2;122;139;153m\u2502\u001b[0m\u001b[38;2;122;139;153m \u001b[0m\u001b[38;2;122;139;153mProduct description, version, creator, and LinkedIn profile.                 \u001b[0m\u001b[38;2;122;139;153m \u001b[0m\u001b[38;2;122;139;153m\u2502\u001b[0m\n\u001b[38;2;122;139;153m\u2502\u001b[0m\u001b[38;2;122;139;153m \u001b[0m\u001b[38;2;122;139;153m8\u001b[0m\u001b[38;2;122;139;153m \u001b[0m\u001b[38;2;122;139;153m\u2502\u001b[0m\u001b[38;2;234;244;248m \u001b[0m\u001b[38;2;234;244;248mExit                            \u001b[0m\u001b[38;2;234;244;248m \u001b[0m\u001b[38;2;122;139;153m\u2502\u001b[0m\u001b[38;2;122;139;153m \u001b[0m\u001b[38;2;122;139;153mLeave MIJHAR.                                                                \u001b[0m\u001b[38;2;122;139;153m \u001b[0m\u001b[38;2;122;139;153m\u2502\u001b[0m\n\u001b[38;2;122;139;153m\u2570\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\