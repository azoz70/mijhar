[4.471784, "o", "\u001b[1;38;2;127;215;232m                                              Select Frameworks to Assess                                               \u001b[0m\n\u256d\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256e\n\u2502\u001b[1;38;2;111;168;201m \u001b[0m\u001b[1;38;2;111;168;201mID      \u001b[0m\u001b[1;38;2;111;168;201m \u001b[0m\u2502\u001b[1;38;2;111;168;201m \u001b[0m\u001b[1;38;2;111;168;201mName                                \u001b[0m\u001b[1;38;2;111;168;201m \u001b[0m\u2502\u001b[1;38;2;111;168;201m \u001b[0m\u001b[1;38;2;111;168;201mVersion                                                \u001b[0m\u001b[1;38;2;111;168;201m \u001b[0m\u2502\u001b[1;38;2;111;168;201m \u001b[0m\u001b[1;38;2;111;168;201mControls\u001b[0m\u001b[1;38;2;111;168;201m \u001b[0m\u2502\n\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\n\u2502\u001b[38;2;234;244;248m \u001b[0m\u001b[38;2;234;244;248mcis     \u001b[0m\u001b[38;2;234;244;248m \u001b[0m\u2502\u001b[38;2;234;244;248m \u001b[0m\u001b[38;2;234;244;248mCIS Benchmarks                      \u001b[0m\u001b[38;2;234;244;248m \u001b[0m\u2502\u001b[38;2;122;139;153m \u001b[0m\u001b[38;2;122;139;153mRepresentative subset (Linux + macOS); verify against  \u001b[0m\u001b[38;2;122;139;153m \u001b[0m\u2502\u001b[38;2;122;139;153m \u001b[0m\u001b[38;2;122;139;153m      14\u001b[0m\u001b[38;2;122;139;153m \u001b[0m\u2502\n\u2502\u001b[38;2;234;244;248m          \u001b[0m\u2502\u001b[38;2;234;244;248m                                      \u001b[0m\u2502\u001b[38;2;122;139;153m \u001b[0m\u001b[38;2;122;139;153mlicensed benchmark                                     \u001b[0m\u001b[38;2;122;139;153m \u001b[0m\u2502\u001b[38;2;122;139;153m          \u001b[0m\u2502\n\u2502\u001b[38;2;234;244;248m \u001b[0m\u001b[38;2;234;244;248miso27001\u001b[0m\u001b[38;2;234;244;248m \u001b[0m\u2502\u001b[38;2;234;244;248m \u001b[0m\u001b[38;2;234;244;248mISO/IEC 27001                       \u001b[0m\u001b[38;2;234;244;248m \u001b[0m\u2502\u001b[38;2;122;139;153m \u001b[0m\u001b[38;2;122;139;153m2022 (Annex A)                                         \u001b[0m\u001b[38;2;122;139;153m \u001b[0m\u2502\u001b[38;2;122;139;153m \u001b[0m\u001b[38;2;122;139;153m      11\u001b[0m\u001b[38;2;122;139;153m \u001b[0m\u2502\n\u2502\u001b[38;2;234;244;248m \u001b[0m\u001b[38;2;234;244;248mnca-ecc \u001b[0m\u001b[38;2;234;244;248m \u001b[0m\u2502\u001b[38;2;234;244;248m \u001b[0m\u001b[38;2;234;244;248mNCA Essential Cybersecurity Controls\u001b[0m\u001b[38;2;234;244;248m \u001b[0m\u2502\u001b[38;2;122;139;153m \u001b[0m\u001b[38;2;122;139;153mECC-2:2024                                             \u001b[0m\u001b[38;2;122;139;153m \u001b[0m\u2502\u001b[38;2;122;139;153m \u001b[0m\u001b[38;2;122;139;153m     199\u001b[0m\u001b[38;2;122;139;153m \u001b[0m\u2502\n\u2502\u001b[38;2;234;244;248m \u001b[0m\u001b[38;2;234;244;248msama-csf\u001b[0m\u001b[38;2;234;244;248m \u001b[0m\u2502\u001b[38;2;234;244;248m \u001b[0m\u001b[38;2;234;244;248mSAMA Cyber Security Framework       \u001b[0m\u001b[38;2;234;244;248m \u001b[0m\u2502\u001b[38;2;122;139;153m \u001b[0m\u001b[38;2;122;139;153mCSF (SAMA Rulebook, Circular 381000091275)             \u001b[0m\u001b[38;2;122;139;153m \u001b[0m\u2502\u001b[38;2;122;139;153m \u001b[0m\u001b[38;2;122;139;153m     252\u001b[0m\u001b[38;2;122;139;153m \u001b[0m\u2502\n\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256f\n"]
